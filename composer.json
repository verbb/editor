{
    "name": "verbb/editor",
    "description": "A Craft-native frontend rich-text editor foundation.",
    "type": "library",
    "version": "1.0.0-dev",
    "support": {
        "email": "support@verbb.io",
        "issues": "https://github.com/verbb/editor/issues?state=open",
        "source": "https://github.com/verbb/editor",
        "docs": "https://verbb.io/packages/editor",
        "rss": "https://github.com/verbb/editor/commits/craft-5.atom"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Verbb",
            "homepage": "https://verbb.io"
        }
    ],
    "require": {
        "php": "^8.2",
        "craftcms/cms": "^5.10.0",
        "ueberdosis/tiptap-php": "^2.1.1",
        "verbb/base": "^3.0.19"
    },
    "require-dev": {
        "pestphp/pest": "^3.8",
        "pestphp/pest-plugin": "^3.0",
        "vlucas/phpdotenv": "^5.6"
    },
    "autoload": {
        "psr-4": {
            "verbb\\editor\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "craftcms/plugin-installer": true,
            "pestphp/pest-plugin": true,
            "yiisoft/yii2-composer": true
        }
    },
    "scripts": {
        "test": "./vendor/bin/pest --bootstrap tests/bootstrap-craft.php -c phpunit.craft.xml tests/Services --exclude-group=slow --exclude-group=perf",
        "test:unit": "./vendor/bin/pest -c phpunit.xml.dist tests/Unit",
        "test:setup": "@php tests/bin/test-setup.php",
        "test:all": "./vendor/bin/pest --bootstrap tests/bootstrap-craft.php -c phpunit.craft.xml tests && ./vendor/bin/pest -c phpunit.xml.dist tests/Unit"
    }
}
